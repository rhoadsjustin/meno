{
  "name": "meno-promo",
  "private": true,
  "description": "Remotion promo video for Meno (LinkedIn / social cut).",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Promo out/meno-promo.mp4",
    "render:abide": "remotion render Abide out/meno-abide.mp4",
    "render:reel": "remotion render Promo-9x16 out/meno-promo-9x16.mp4",
    "render:abide:reel": "remotion render Abide-9x16 out/meno-abide-9x16.mp4",
    "render:advent": "remotion render Advent out/meno-advent.mp4",
    "render:advent:reel": "remotion render Advent-9x16 out/meno-advent-9x16.mp4",
    "render:whatsnew": "remotion render WhatsNew out/meno-1.9.mp4",
    "render:whatsnew:reel": "remotion render WhatsNew-9x16 out/meno-1.9-9x16.mp4",
    "still:whatsnew": "remotion still WhatsNewCard out/meno-1.9-post.png --frame=39 && remotion still WhatsNewCard-9x16 out/meno-1.9-story.png --frame=39",
    "typecheck": "tsc",
    "music": "python3 scripts/music.py",
    "render:duo": "remotion render Duo out/meno-duo.mp4",
    "captures:duo": "bash scripts/duo-captures.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
