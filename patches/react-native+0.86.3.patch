+// Patched (patches/react-native+0.86.3.patch): drop this on react-native
+// 0.87+, which re-measures stale text natively (react/react-native#57246).
+//
+// When the system text size changes while the app runs, Fabric re-measures
+// text on its native branch only. The next React commit (a tab switch, any
+// state update) puts back the text nodes React holds, still measured at the
+// old size, so glyphs draw at the new size in the old frame and clip until
+// relaunch. Counting font-scale changes and keying each root text element on
+// the count makes React build fresh native text nodes, measured at the
+// current scale, once per change. Components and their state stay mounted.
+let fontScaleGeneration = 0;
+let lastFontScale: ?number = null;
+let fontScaleSubscription: ?{remove: () => void, ...} = null;
+const fontScaleListeners: Set<() => void> = new Set();
+
+function subscribeToFontScale(listener: () => void): () => void {
+  fontScaleListeners.add(listener);
+  if (fontScaleSubscription == null) {
+    lastFontScale = Dimensions.get('window').fontScale;
+    fontScaleSubscription = Dimensions.addEventListener(
+      'change',
+      ({window}) => {
+        if (window.fontScale === lastFontScale) {
+          return;
+        }
+        lastFontScale = window.fontScale;
+        fontScaleGeneration++;
+        fontScaleListeners.forEach(notify => notify());
+      },
+    );
+  }
+  return () => {
+    fontScaleListeners.delete(listener);
+  };
+}
+
+function getFontScaleGeneration(): number {
+  return fontScaleGeneration;
+}
